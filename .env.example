# Copy this file to .env and change values as needed. Never commit .env.
API_BASE_URL=http://localhost:8000
# Select exactly one: groq or google
LLM_PROVIDER=groq

# Groq settings (used only when LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google AI Studio / Gemini settings (used only when LLM_PROVIDER=google)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash
# Used by the included demo_api only. Remove for a real target API.
TEST_RESET_PATH=/__test/reset

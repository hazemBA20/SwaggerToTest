# Copy this file to .env and change values as needed. Never commit .env.
API_BASE_URL=http://localhost:8000

# API Authentication - set based on your OpenAPI spec's security schemes
# For Bearer token auth (type: http, scheme: bearer)
API_BEARER_TOKEN=
# For API key auth in headers (type: apiKey, in: header, name: X-HEADER-NAME)
# Example: API_KEY_X_API_KEY=your-key-here
API_KEY_X_API_KEY=

# Anthropic API key for the agentic pipeline
ANTHROPIC_API_KEY=

# Used by the included demo_api only. Remove for a real target API.
TEST_RESET_PATH=/__test/reset
